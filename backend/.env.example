# Copy this file to .env and edit.
# Using Kaggle? Run kaggle/learnwise_qwen3_server.ipynb: its last block prints every line you need
# (USE_MOCKS, LLM_*, EMBEDDING_*). Paste that block at the very bottom of this file: when a setting
# appears twice, the LAST one wins, so you never have to edit the lines above.

# true = every endpoint returns fake data (no LLM, no embeddings needed)
USE_MOCKS=true

# Only used when USE_MOCKS=false. true = real LLM, but fake "retrieved passages"
# (use this to work on prompts before ingestion/retrieval is finished)
MOCK_RETRIEVAL=false

# Any OpenAI-compatible server. The adapter calls {LLM_BASE_URL}/chat/completions
#   Kaggle + Ollama via tunnel : https://xxxx.trycloudflare.com/v1
#   Ollama on your laptop      : http://localhost:11434/v1
#   Groq free tier             : https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# The Kaggle notebook prints a secret key; Ollama on your laptop doesn't need one
LLM_API_KEY=not-needed
LLM_TIMEOUT_SECONDS=120
# Qwen3 "thinks" by default; this turns it off so answers are fast and JSON is clean
LLM_DISABLE_THINKING=true

# Embeddings: same model either way
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Empty = compute on this laptop (pip install -r requirements-local-embeddings.txt).
# Kaggle URL (same as LLM_BASE_URL) = compute on Kaggle's GPU, nothing extra to install.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=not-needed
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Drop retrieved passages with cosine similarity below this (0-1)
MIN_SCORE=0.2
# Hybrid retrieval: BM25 keyword search fused with the embedding search (Reciprocal Rank Fusion, k=RRF_K)
HYBRID_RETRIEVAL=true
RRF_K=60
# Optional cross-encoder re-ranking of the top RERANK_CANDIDATES fused passages (needs sentence-transformers).
# Empty = off. Example: cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MODEL=
RERANK_CANDIDATES=20
# Max tokens of retrieved text per prompt (duplicates removed, neighbouring chunks merged, best passages first)
CONTEXT_BUDGET_TOKENS=2000
# Check /api/ask answers against their cited passages; retry, then mark grounded=false if still unsupported
VERIFY_ANSWERS=true
VERIFY_SENTENCE_SUPPORT=0.5
VERIFY_MIN_SUPPORT=0.75
VERIFY_RETRIES=1

# Follow-up memory on the Ask page: earlier exchanges used to understand "why is that?" (0 = off)
ASK_HISTORY_TURNS=3
ASK_HISTORY_CHARS=1600

# AI voice for Ask answers (Kokoro on the Kaggle notebook; it prints these lines). Empty = the browser's voice.
TTS_BASE_URL=
TTS_API_KEY=not-needed
TTS_VOICE=af_heart

DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# ---- paste the Kaggle notebook's block below this line (replace the old block after a restart) ----
